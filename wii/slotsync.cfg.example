# SlotSync for Wii -- copy to sd:/slotsync/slotsync.cfg and edit.

# The server's address. A dotted quad, not a hostname: there is no DNS on the
# console ingest path, deliberately (PLAN.md section 2).
server     = 192.168.1.10
port       = 9977

# Must match SLOTSYNC_PSK on the server exactly. A mismatch shows up as
# "bad hmac" rather than as a connection failure.
psk        = changeme

# Identifies this console in the server's version history. Any u64; give each
# console in the house a different one.
device_id  = 0x5749490000000001

# Where Nintendont keeps its cards, and what to launch when the sync is done.
saves_dir  = sd:/saves
nintendont = sd:/apps/Nintendont/boot.dol

# 1 to launch Nintendont as soon as the sync finishes, 0 to wait for a button
# so you can read the log.
autoboot   = 1

# Per-reply timeout and how many retransmission rounds before giving up.
timeout_ms = 2000
rounds     = 12

# ---------------------------------------------------------------------------
# Runtime sync, read by the in-kernel client in nintendont/ and ignored by the
# wrapper. Only has an effect on a Nintendont build that has been patched with
# nintendont/apply.sh.
# ---------------------------------------------------------------------------

# 1 to push cards to the server while the game is running, 0 to leave that to
# the wrapper on either side of a session.
runtime_sync = 1

# How long a card must go untouched before it is pushed. A game writing a save
# touches it several times in a row; this waits for it to finish.
runtime_quiet_ms = 4000

# Minimum gap between two pushes of the same card. Every push sends the whole
# card, so this is what keeps a game that saves often off the radio.
runtime_cooldown_ms = 30000

# How long to wait for DHCP before giving up and backing off.
runtime_net_timeout_ms = 20000

# Send pacing: pause for `pace_us` after every `pace_every` datagrams.
#
# Not about the server's rate limit, which is what these were first set from.
# IOS's send path is the constraint: unpaced it refuses about three quarters of
# a card's datagrams, and every refusal costs a retransmission round. 64 per
# 160 ms is 400/sec, measured on hardware as the rate at which a 2 MiB card
# lands with zero sends refused -- roughly five seconds of radio time, thin
# enough that the running game does not notice it.
runtime_pace_every = 64
runtime_pace_us = 160000

# ---------------------------------------------------------------------------
# Transfer tuning for the launcher. The kernel has its own runtime_* pacing
# above; these are what the launcher uses before the game starts.
# ---------------------------------------------------------------------------

# How many chunks a single pull round asks for.
#
# The server answers a PULL_REQ with an unsolicited burst, and the console's
# receive buffer holds around forty datagrams -- so asking for a whole 2 MiB
# card at once means the burst overruns it and the round salvages a bufferful.
# Measured: forty-five chunks recovered per round, so a 2 MiB card never
# finished. Asking for a window the buffer can hold makes every round land
# whole. Raise it if pulls are slow and nothing is being dropped; lower it if
# a round comes back short.
pull_window = 32

# Send pacing, same idea in the other direction: pause for `pace_us` after
# every `pace_every` datagrams. Without it the IOS send path refuses about
# three quarters of a card's chunks and they all come back as retransmission
# rounds. 0 disables the pause.
pace_every = 16
pace_us = 20000
