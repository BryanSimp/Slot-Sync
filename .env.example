# Shared secret for the HTTP API (Dolphin daemon, web UI, curl).
# Generate with: openssl rand -hex 32
SLOTSYNC_TOKEN=changeme

# Pre-shared key for the binary UDP protocol (Wii / Nintendont clients).
# Must be embedded in the console client build. Keep it LAN-only.
# Generate with: openssl rand -hex 32
SLOTSYNC_PSK=changeme

# The server refuses to start while either of the above is unset or still
# says "changeme".

# --- everything below is optional; these are the defaults -------------------

# SLOTSYNC_DATA=/data
# SLOTSYNC_HTTP_HOST=0.0.0.0
# SLOTSYNC_HTTP_PORT=8080
# SLOTSYNC_UDP_HOST=0.0.0.0
# SLOTSYNC_UDP_PORT=9977
# SLOTSYNC_LOG_LEVEL=INFO

# Whose X-Forwarded-* headers to believe. "*" suits the documented setup --
# a reverse proxy in front, on a LAN -- but narrow it to the proxy's address
# if the container is reachable more widely.
# SLOTSYNC_FORWARDED_ALLOW_IPS=*

# Largest card accepted. 16 MiB is Memory Card 2043, the biggest real one.
# SLOTSYNC_MAX_CARD_BYTES=16777216

# Pushes in flight, and how long one survives without a chunk.
# SLOTSYNC_MAX_STAGING=64
# SLOTSYNC_STAGING_TTL=120

# UDP receive buffer. A 2 MiB card arrives as 2048 datagrams; the stock socket
# buffer drops about a third of an unpaced burst. See docs/PROTOCOL.md.
# SLOTSYNC_UDP_RCVBUF=4194304

# Per-source datagram budget: burst size, then sustained datagrams per second.
# Must clear a whole card's burst -- throttling a real console is worse than
# the flood it would prevent.
# SLOTSYNC_UDP_BURST=4096
# SLOTSYNC_UDP_RATE=2048

# Pull pacing: chunks sent back to back, then a pause. The receiving WiFi
# stack is from 2006.
# SLOTSYNC_PULL_BURST=32
# SLOTSYNC_PULL_BURST_DELAY=0.002

# How long a control-message nonce is remembered, for replay rejection.
# SLOTSYNC_NONCE_TTL=120

# Failed HTTP authentications per client address before the limiter refuses,
# and how fast that budget refills, per second.
# SLOTSYNC_AUTH_ATTEMPTS=10
# SLOTSYNC_AUTH_REFILL=0.2
