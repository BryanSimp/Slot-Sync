# Shared secret for the HTTP API (Dolphin daemon, web UI, curl).
# Generate with: openssl rand -hex 32
SLOTSYNC_TOKEN=changeme

# Pre-shared key for the binary UDP protocol (Wii / Nintendont clients).
# Must be embedded in the console client build. Keep it LAN-only.
# Generate with: openssl rand -hex 32
SLOTSYNC_PSK=changeme
