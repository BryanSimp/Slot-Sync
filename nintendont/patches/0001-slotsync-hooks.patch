diff --git a/kernel/kernel.ld b/kernel/kernel.ld
index 77907d1..c390ebe 100644
--- a/kernel/kernel.ld
+++ b/kernel/kernel.ld
@@ -21,6 +21,12 @@ __intr_stack_addr = __hid_stack_addr + __intr_stack_size;
 __blk_stack_size = 0x400;
 __blk_stack_addr = __intr_stack_addr + __blk_stack_size;
 
+/* SlotSync worker. Bigger than its neighbours because the protocol core builds
+ * a 1120-byte datagram on the stack at each of three nesting levels. The
+ * region is 0x10000 long and the stacks above it total 0x4000, so this fits. */
+__slotsync_stack_size = 0x4000;
+__slotsync_stack_addr = __blk_stack_addr + __slotsync_stack_size;
+
 MEMORY {
 
 	code		: ORIGIN = 0x12F00000,	LENGTH = 0x60000
